{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_updates"
  ],
  "properties": {
    "memory_updates": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "target_memory_id",
          "memory_type",
          "anchor_path",
          "trigger",
          "claim",
          "inspect_paths",
          "links",
          "evidence_paths"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "add",
              "revise",
              "retire"
            ]
          },
          "target_memory_id": {
            "type": "string"
          },
          "memory_type": {
            "type": "string",
            "enum": [
              "semantic",
              "procedural",
              "episodic"
            ]
          },
          "anchor_path": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "maxLength": 400
          },
          "inspect_paths": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation",
                "target_path",
                "reason"
              ],
              "properties": {
                "relation": {
                  "type": "string",
                  "enum": [
                    "consumed_by",
                    "observed_by",
                    "co_maintained_with"
                  ]
                },
                "target_path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "evidence_paths": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
