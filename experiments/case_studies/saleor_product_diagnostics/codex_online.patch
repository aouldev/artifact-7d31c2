+const makeVerificationResult = (
+  overrides: Partial<ChannelVerificationResult["result"]> = {},
+): ChannelVerificationResult => ({
+  channelId: "channel-1",
+  channelSlug: "default-channel",
+  status: "success",
+  error: null,
+  result: {
+    productFound: true,
+    isAvailable: true,
+    isAvailableForPurchase: true,
+    availableForPurchaseAt: null,
+    variantsWithStock: 1,
+    totalVariants: 1,
+    variants: [],
+    ...overrides,
+  },
+});
+
+describe("PublicApiVerificationBadge", () => {
+  it("warns about missing coverage in legacy mode", () => {
+    render(
+      <PublicApiVerificationBadge
+        result={makeVerificationResult()}
+        useLegacyShippingZoneStockAvailability
+        shippingZoneCount={0}
+        isShippingRequired
+      />,
+      { wrapper: Wrapper },
+    );
+
+    expect(screen.getByText("Reports stock, but no coverage")).toBeInTheDocument();
+    expect(screen.getByTestId("verification-reassurance")).toHaveAttribute(
+      "data-test-reassurance",
+      "not-reachable-legacy",
+    );
+  });
+
+  it("explains the browseable-but-not-shippable state in direct mode", () => {
+    render(
+      <PublicApiVerificationBadge
+        result={makeVerificationResult()}
+        useLegacyShippingZoneStockAvailability={false}
+        shippingZoneCount={0}
+        isShippingRequired
+      />,
+      { wrapper: Wrapper },
+    );
+
+    expect(screen.getByText("Browseable, can't ship")).toBeInTheDocument();
+    expect(screen.getByTestId("verification-reassurance")).toHaveAttribute(
+      "data-test-reassurance",
+      "not-deliverable-direct",
+    );
+  });
+
+  it("keeps non-shippable products purchasable without shipping zones", () => {
+    render(
+      <PublicApiVerificationBadge
+        result={makeVerificationResult()}
+        shippingZoneCount={0}
+        isShippingRequired={false}
+      />,
+      { wrapper: Wrapper },
+    );
+
+    expect(screen.getByText("Purchasable")).toBeInTheDocument();
+    expect(screen.queryByText("Reports stock, but no coverage")).toBeNull();
+  });
+});
